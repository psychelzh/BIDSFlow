# Generated by `bidsflow init`.
# Review before first use:
# - adjust [project].name if you want a clearer project label
# - adjust [paths] if your project layout differs from this scaffold
# - review [execution] if you use a scheduler such as SGE
# - optionally configure [resources] for shared external resources such as FreeSurfer
# - review target configs under config/

[project]
name = __PROJECT_NAME__
root = "."

[paths]
source_root = "sourcedata"
raw_bids_root = "sourcedata/raw"
derivatives_root = "derivatives"
work_root = "work"
logs_root = "logs"
state_root = "state"

__EXECUTION_SECTION__
[resources]
# FreeSurfer requires a license for recon-all and FreeSurfer-dependent outputs.
# Get one from https://surfer.nmr.mgh.harvard.edu/registration.html
