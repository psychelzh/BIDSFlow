#!/usr/bin/env bash
# BIDSFlow-generated array runtime helpers.
#
# This file is sourced by target-specific runtime scripts. It owns the common
# array-task contract, unit status files, results.tsv append, and claim cleanup.

task_id="${BIDSFLOW_TASK_ID:?BIDSFLOW_TASK_ID is required.}"
scheduler_name="${BIDSFLOW_SCHEDULER:-unknown}"
scheduler_job_id="${BIDSFLOW_SCHEDULER_JOB_ID:-unknown}"
project_root={{ shell_project_root }}
unit_list_path={{ shell_unit_list_path }}
results_table_path={{ shell_results_table_path }}
results_table_lock="${results_table_path}.lock"
scheduler_log_dir={{ shell_scheduler_log_dir }}
cleanup_workdir="{{ cleanup_workdir }}"
results_lock_acquired="false"

bidsflow_cleanup_results_table_lock() {
    if [[ "${results_lock_acquired:-false}" == "true" ]]; then
        rmdir "$results_table_lock" 2>/dev/null || true
        results_lock_acquired="false"
    fi
}
trap bidsflow_cleanup_results_table_lock EXIT
trap 'bidsflow_cleanup_results_table_lock; exit 130' INT
trap 'bidsflow_cleanup_results_table_lock; exit 143' TERM

unit_row="$(sed -n "$((task_id + 1))p" "$unit_list_path")"
if [[ -z "$unit_row" ]]; then
    printf '[bidsflow] Unit row was not found for BIDSFlow task %s in %s\n' "$task_id" "$unit_list_path" >&2
    exit 4
fi

# Convert tabs to a non-whitespace delimiter before read, so an empty
# session_label field does not shift later fields.
unit_row="${unit_row//$'\t'/$'\034'}"
IFS=$'\034' read -r unit_name source_name subject_label session_label execution_path claim_path unit_status_path extra <<< "$unit_row"
if [[ -z "$unit_name" || -z "$source_name" || -z "$subject_label" || -z "$execution_path" || -z "$claim_path" || -z "$unit_status_path" || -n "${extra:-}" ]]; then
    printf '[bidsflow] Unit row is incomplete for BIDSFlow task %s\n' "$task_id" >&2
    exit 5
fi

bidsflow_write_unit_status() {
    local unit_status="$1"
    local exit_code="${2-}"
    local started="${3-}"
    local finished="${4-}"
    local error="${5-}"
    local tmp_path="${unit_status_path}.tmp.$$"

    mkdir -p "$(dirname "$unit_status_path")"
    {
        printf 'status=%s\n' "$unit_status"
        printf 'unit=%s\n' "$unit_name"
        printf 'source=%s\n' "$source_name"
        printf 'subject=%s\n' "$subject_label"
        printf 'session=%s\n' "$session_label"
        printf 'backend=%s\n' "$scheduler_name"
        printf 'attempt=%s\n' "{{ attempt_label }}"
        printf 'started_at=%s\n' "$started"
        printf 'finished_at=%s\n' "$finished"
        printf 'exit_code=%s\n' "$exit_code"
        printf 'log_dir=%s\n' "$scheduler_log_dir"
        printf 'scheduler=%s\n' "$scheduler_name"
        printf 'job_id=%s\n' "$scheduler_job_id"
        printf 'task_id=%s\n' "$task_id"
        if [[ -n "$error" ]]; then
            printf 'error=%s\n' "$error"
        fi
    } > "$tmp_path"
    mv -f "$tmp_path" "$unit_status_path"
}

bidsflow_append_final_result() {
    local final_unit_status="$1"
    local exit_code="$2"
    local started="$3"
    local finished="$4"
    local notes="${5-}"
    local summary
    local waited_seconds=0
    local max_wait_seconds=300
    local append_status

    if [[ -n "$session_label" ]]; then
        summary="sub-${subject_label} ses-${session_label}"
    else
        summary="sub-${subject_label}"
    fi

    printf '[bidsflow] Recording result: %s\n' "$results_table_path"
    if ! mkdir -p "$(dirname "$results_table_path")"; then
        printf '[bidsflow] Failed to create results table directory: %s\n' "$(dirname "$results_table_path")" >&2
        return 6
    fi
    while ! mkdir "$results_table_lock" 2>/dev/null; do
        if [[ -e "$results_table_lock" && ! -d "$results_table_lock" ]]; then
            printf '[bidsflow] Results table lock path exists but is not a directory: %s\n' "$results_table_lock" >&2
            return 6
        fi
        if (( waited_seconds >= max_wait_seconds )); then
            printf '[bidsflow] Timed out waiting for results table lock: %s\n' "$results_table_lock" >&2
            return 6
        fi
        sleep 1
        waited_seconds=$((waited_seconds + 1))
    done
    results_lock_acquired="true"
    {
        if [[ ! -s "$results_table_path" ]]; then
            printf 'unit_name\tsource_name\tsubject_label\tsession_label\tsummary\tstatus\texit_code\tstarted_at\tfinished_at\tlog_path\tscheduler\tscheduler_job_id\tscheduler_task_id\tnotes\n'
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$unit_name" \
            "$source_name" \
            "$subject_label" \
            "$session_label" \
            "$summary" \
            "$final_unit_status" \
            "$exit_code" \
            "$started" \
            "$finished" \
            "$scheduler_log_dir" \
            "$scheduler_name" \
            "$scheduler_job_id" \
            "$task_id" \
            "$notes"
    } >> "$results_table_path"
    append_status=$?
    bidsflow_cleanup_results_table_lock
    if [[ "$append_status" -eq 0 ]]; then
        printf '[bidsflow] Result recorded: %s\n' "$results_table_path"
    else
        printf '[bidsflow] Failed to append result row: %s (status %s)\n' "$results_table_path" "$append_status" >&2
    fi
    return "$append_status"
}

bidsflow_finish_unit() {
    local final_unit_status="$1"
    local exit_code="$2"
    local started="$3"
    local finished="$4"
    local error="${5-}"
    local append_status
    local append_error_message

    bidsflow_write_unit_status "$final_unit_status" "$exit_code" "$started" "$finished" "$error"
    bidsflow_append_final_result "$final_unit_status" "$exit_code" "$started" "$finished" "$error"
    append_status=$?
    if [[ "$append_status" -ne 0 ]]; then
        append_error_message="Failed to append results.tsv row (status $append_status)"
        if [[ -n "$error" ]]; then
            error="${error}; ${append_error_message}"
        else
            error="$append_error_message"
        fi
        if [[ "$exit_code" -eq 0 ]]; then
            final_unit_status="failed"
        fi
        bidsflow_write_unit_status "$final_unit_status" "$exit_code" "$started" "$finished" "$error"
        rm -f -- "$claim_path"
        printf '[bidsflow] %s\n' "$append_error_message" >&2
        exit "$append_status"
    fi

    if [[ "$cleanup_workdir" == "true" ]]; then
        rm -f -- "$execution_path"
        rmdir "$(dirname "$execution_path")" 2>/dev/null || true
    fi
    rm -f -- "$claim_path"
}
