#!/usr/bin/env bash
# BIDSFlow-generated HeuDiConv runtime script.
#
# Do not edit this file directly. It is regenerated for each run under
# work/heudiconv/... and is called by the project-local scheduler wrapper.

set -uo pipefail

source {{ common_runtime_script }}

launcher=(
{{ shell_launcher_items }}
)

command=(
    "${launcher[@]}"
    "--files" "$execution_path"
    "-o" {{ shell_raw_bids_root }}
    "-f" {{ shell_heuristic_path }}
    "-c" "dcm2niix"
    "-b"
    "-s" "$subject_label"
)
if [[ -n "$session_label" ]]; then
    command+=("-ss" "$session_label")
fi

started_at="$(date -Is)"
run_error_message=""
error_message=""
status=""
finished_at=""
bidsflow_write_unit_status "running" "" "$started_at" "" ""

printf '[bidsflow] HeuDiConv task started: %s\n' "$started_at"
printf '[bidsflow] Scheduler job/task: %s/%s\n' "$scheduler_job_id" "$task_id"
printf '[bidsflow] Unit: %s (source=%s, subject=%s, session=%s)\n' "$unit_name" "$source_name" "$subject_label" "${session_label:-none}"
printf '[bidsflow] Command:'
printf ' %q' "${command[@]}"
printf '\n\n'

# Keep command failures recordable even if site setup enabled `set -e`.
set +e
if cd -- "$project_root"; then
    "${command[@]}"
    status=$?
    if [[ "$status" -ne 0 ]]; then
        run_error_message="Command failed with exit status $status"
        printf '[bidsflow] %s\n' "$run_error_message" >&2
    fi
else
    status=$?
    run_error_message="Failed to change to project root: $project_root (status $status)"
    printf '[bidsflow] %s\n' "$run_error_message" >&2
fi

finished_at="$(date -Is)"
if [[ "$status" -eq 0 ]]; then
    final_status="succeeded"
    error_message=""
else
    final_status="failed"
    error_message="$run_error_message"
    if [[ -z "$error_message" ]]; then
        error_message="Command failed with exit status $status"
    fi
fi

bidsflow_finish_unit "$final_status" "$status" "$started_at" "$finished_at" "$error_message"

printf '\n[bidsflow] Finished: %s\n' "$finished_at"
printf '[bidsflow] Exit status: %s\n' "$status"

exit "$status"
